{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Tutelia : aperçu local",
			"type": "shell",
			"command": "npm run dev",
			"options": { "cwd": "${workspaceFolder}" },
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Tutelia : vérifier",
			"type": "shell",
			"command": "npm run verify",
			"options": { "cwd": "${workspaceFolder}" },
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "Tutelia : générer les fichiers statiques",
			"type": "shell",
			"command": "npm run build",
			"options": { "cwd": "${workspaceFolder}" },
			"group": { "kind": "build", "isDefault": true },
			"problemMatcher": []
		}
	]
}